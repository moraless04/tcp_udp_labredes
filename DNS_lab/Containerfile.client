FROM debian:bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        dnsutils \
        iproute2 \
        iputils-ping \
        less \
        procps \
        tcpdump \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash student

USER student
WORKDIR /home/student

CMD ["tail", "-f", "/dev/null"]
